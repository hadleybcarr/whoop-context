# Copy to .env for local runs, or set these as environment variables on your host. All optional.

# Your WHOOP app (https://developer-dashboard.whoop.com). Without these, each visitor
# connects with their own WHOOP app or uses sample data.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Google OAuth client ID for Calendar (instead of editing web/js/config.js).
GOOGLE_CLIENT_ID=

# Where people reach the app; PUBLIC_URL/auth/whoop/callback is the WHOOP redirect URL.
# Defaults to http://localhost:8000 locally. Render, Railway and Fly.io set it for you.
# PUBLIC_URL=https://your-app.example
